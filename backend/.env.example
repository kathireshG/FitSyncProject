NODE_ENV=development
HOST=127.0.0.1
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/fitness
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=1d
RESET_TOKEN_TTL_MINUTES=30
UPLOAD_DIR=./uploads/avatars

# Email is optional for local development. Contact and password-reset email
# endpoints return an error until these values are configured.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
CONTACT_EMAIL=
